# LocalLife — local environment template (NO secrets in git)
# Copy to apps/api/.env and fill values.

# PostgreSQL (create DB: locallife_dev)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/locallife_dev?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API
NODE_ENV=development
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"
THROTTLE_LIMIT=120

# AI (OpenRouter) — leave empty for grounded mock mode in local/tests
OPENROUTER_API_KEY=""

# Support / ops
SUPPORT_FORM_URL="https://forms.gle/locallife-support-placeholder"

# Maps / monitoring / storage (optional in early phases)
MAPBOX_TOKEN=""
SENTRY_DSN=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
