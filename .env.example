# LocalLife — local environment template (NO secrets in git)
# Copy to apps/api/.env and fill values.

# PostgreSQL (create DB: locallife_dev)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/locallife_dev?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"

# Optional later
OPENROUTER_API_KEY="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"
