DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/locallife_dev?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"
OPENROUTER_API_KEY=""
MAPBOX_TOKEN=""

# Weather (Open-Meteo). Empty key uses public api.open-meteo.com.
# Set WEATHER_API_KEY for commercial customer-api.open-meteo.com access.
WEATHER_PROVIDER="openmeteo"
WEATHER_API_KEY=""

# Optional R2 media uploads (POST /v1/media/presign). Without these, Guides paste URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
R2_PUBLIC_BASE_URL=""

# Google Sign-In (CLIENT only). Token verify audiences = these client IDs.
# GOOGLE_CLIENT_ID must be the WEB OAuth client (same as EXPO_PUBLIC_GOOGLE_CLIENT_ID).
# Also add iOS/Android client IDs so idTokens from those apps verify.
GOOGLE_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
# Only for local/dev e2e: accept mock: tokens (NODE_ENV=test also enables mock)
GOOGLE_AUTH_MOCK=""
