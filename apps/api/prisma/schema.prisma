generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  GUIDE
  BUSINESS
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PersonaType {
  TOURIST
  STUDENT
  EXPAT
  BUSINESS
  LOCAL
}

enum BudgetBand {
  LOW
  MEDIUM
  HIGH
}

enum VerificationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ClaimStatus {
  UNCLAIMED
  PENDING
  VERIFIED
  REJECTED
}

enum GuideApplicationStatus {
  APPLIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum PriceLevel {
  FREE
  BUDGET
  MODERATE
  EXPENSIVE
  LUXURY
}

enum TransportMode {
  BUS
  METRO
  TRAM
  TRAIN
  TAXI
  RIDE_HAILING
  SHARED_TAXI
  FERRY
  BOAT
  BIKE
  SCOOTER
  WALK
  CAR_RENTAL
  AIRPORT_SHUTTLE
  OTHER
}

enum PricingType {
  FIXED
  METERED
  ZONE
  SUBSCRIPTION
  NEGOTIABLE
  FREE
  UNKNOWN
}

enum PaymentMethod {
  CASH
  CARD
  CONTACTLESS
  BANK_TRANSFER
  MOBILE_MONEY
  APP_PAY
  TRANSPORT_CARD
  QR_PAY
  OTHER
}

enum RuleScope {
  COUNTRY
  REGION
  CITY
  DISTRICT
  PLACE
}

enum RuleSeverity {
  INFO
  IMPORTANT
  CRITICAL
}

enum RuleCategory {
  ENTRY_VISA
  SAFETY
  TRANSPORT
  MONEY
  DRESS_CULTURE
  RELIGION_CUSTOMS
  ALCOHOL
  PHOTOGRAPHY
  HEALTH
  INTERNET_COMMS
  HOUSING
  WORK_STUDY
  EMERGENCY
  SCAM_WARNING
  OTHER
}

enum SourceType {
  OFFICIAL
  ADMIN
  GUIDE_VERIFIED
  BUSINESS
  COMMUNITY
  IMPORTED
}

enum GuideActionType {
  CLEAR_IMMIGRATION
  BUY_SIM
  EXCHANGE_MONEY
  WITHDRAW_ATM
  TAKE_TAXI
  TAKE_SHARED_TAXI
  TAKE_BUS
  TAKE_FERRY
  BOOK_TRANSFER
  GO_TO_PLACE
  BUY_TICKET
  INSTALL_APP
  REGISTER_ACCOUNT
  CHECK_SAFETY
  OTHER
}

enum GuideParentType {
  ARRIVAL_GUIDE
  HOW_TO_GUIDE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum FavoriteTargetType {
  PLACE
  EVENT
  EXPERIENCE
}

enum ReportTargetType {
  PLACE
  REVIEW
  EVENT
  USER
  MESSAGE
  GUIDE_CONTENT
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum GeoStatus {
  DRAFT
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  role         UserRole   @default(CLIENT)
  displayName  String
  avatarUrl    String?
  phone        String?
  locale       String     @default("en")
  preferredCurrency String @default("TND")
  personaType  PersonaType?
  isEmailVerified Boolean @default(false)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  preference      UserPreference?
  refreshTokens   RefreshToken[]
  guideProfile    GuideProfile?
  businessProfile BusinessProfile?
  reviews         Review[]
  favorites       Favorite[]
  reports         Report[]
  conversations   Conversation[]
  auditLogs       AuditLog[]
  placesCreated   Place[]         @relation("PlaceCreatedBy")
}

model UserPreference {
  userId                  String     @id
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetBand              BudgetBand @default(MEDIUM)
  homeCityId              String?
  dietaryNotes            String?
  accessibilityNotes      String?
  notifyRecommendations   Boolean    @default(true)
  notifyEvents            Boolean    @default(true)
  notifyMarketing         Boolean    @default(false)
  quietHoursJson          Json?
  consentAnalytics        Boolean    @default(false)
  consentPersonalization  Boolean    @default(false)
  consentPush             Boolean    @default(false)
  consentMarketing        Boolean    @default(false)
  consentUpdatedAt        DateTime?
  updatedAt               DateTime   @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Country {
  id                   String    @id @default(uuid())
  iso2                 String    @unique @db.Char(2)
  iso3                 String    @unique @db.Char(3)
  name                 String
  defaultLocale        String    @default("en")
  defaultCurrency      String    @db.Char(3)
  timezoneDefault      String?
  emergencyNumbersJson Json?
  status               GeoStatus @default(DRAFT)
  packVersion          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  regions           Region[]
  cities            City[]
  transportSystems  TransportSystem[]
  localRules        LocalRule[]
}

model Region {
  id        String    @id @default(uuid())
  countryId String
  country   Country   @relation(fields: [countryId], references: [id])
  name      String
  code      String?
  status    GeoStatus @default(DRAFT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  cities City[]
}

model City {
  id                 String    @id @default(uuid())
  countryId          String
  country            Country   @relation(fields: [countryId], references: [id])
  regionId           String?
  region             Region?   @relation(fields: [regionId], references: [id])
  name               String
  slug               String
  latitude           Decimal?  @db.Decimal(10, 7)
  longitude          Decimal?  @db.Decimal(10, 7)
  status             GeoStatus @default(DRAFT)
  isFeatured         Boolean   @default(false)
  contentPackVersion String?
  defaultLocale      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  places           Place[]
  events           Event[]
  experiences      Experience[]
  transportSystems TransportSystem[]
  arrivalGuides    ArrivalGuide[]
  howToGuides      HowToGuide[]
  localRules       LocalRule[]
  conversations    Conversation[]
  districts        District[]
  guideProfilesBase GuideProfile[] @relation("GuideBaseCity")
  businessProfilesBase BusinessProfile[] @relation("BusinessBaseCity")

  @@unique([countryId, slug])
  @@index([status])
}

model District {
  id        String   @id @default(uuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guideProfiles    GuideProfile[]    @relation("GuidePrimaryDistrict")
  businessProfiles BusinessProfile[] @relation("BusinessPrimaryDistrict")

  @@unique([cityId, slug])
  @@index([cityId])
}

model Category {
  id        String   @id @default(uuid())
  parentId  String?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  key       String   @unique
  name      String
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  places Place[]
  events Event[]
}

model Place {
  id                 String             @id @default(uuid())
  cityId             String
  city               City               @relation(fields: [cityId], references: [id])
  slug               String
  name               String
  summary            String
  description        String?
  latitude           Decimal            @db.Decimal(10, 7)
  longitude          Decimal            @db.Decimal(10, 7)
  addressText        String?
  phone              String?
  website            String?
  priceLevel         PriceLevel?
  primaryCategoryId  String?
  primaryCategory    Category?          @relation(fields: [primaryCategoryId], references: [id])
  verificationStatus VerificationStatus @default(DRAFT)
  sourceType         SourceType         @default(ADMIN)
  isSponsored        Boolean            @default(false)
  sponsoredUntil     DateTime?
  trustScore         Decimal?           @db.Decimal(5, 2)
  popularityScore    Decimal?           @db.Decimal(5, 2)
  createdByUserId    String?
  createdBy          User?              @relation("PlaceCreatedBy", fields: [createdByUserId], references: [id])
  ownedByBusinessId  String?
  ownedByBusiness    BusinessProfile?   @relation(fields: [ownedByBusinessId], references: [id])
  publishedAt        DateTime?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  photos       PlacePhoto[]
  hours        PlaceHour[]
  reviews      Review[]
  claims       BusinessPlaceClaim[]
  transportHubs TransportHub[]

  @@unique([cityId, slug])
  @@index([cityId, verificationStatus])
}

model PlacePhoto {
  id               String             @id @default(uuid())
  placeId          String
  place            Place              @relation(fields: [placeId], references: [id], onDelete: Cascade)
  url              String
  caption          String?
  sortOrder        Int                @default(0)
  uploadedByUserId String?
  status           VerificationStatus @default(APPROVED)
  createdAt        DateTime           @default(now())
}

model PlaceHour {
  id        String  @id @default(uuid())
  placeId   String
  place     Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  opensAt   String?
  closesAt  String?
  isClosed  Boolean @default(false)
}

model GuideProfile {
  id                 String                 @id @default(uuid())
  userId             String                 @unique
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  languages          String[]
  status             GuideApplicationStatus @default(APPLIED)
  trustScore         Decimal?               @db.Decimal(5, 2)
  portfolioUrl       String?
  baseCityId         String?
  baseCity           City?                  @relation("GuideBaseCity", fields: [baseCityId], references: [id])
  primaryDistrictId  String?
  primaryDistrict    District?              @relation("GuidePrimaryDistrict", fields: [primaryDistrictId], references: [id])
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([baseCityId])
  @@index([primaryDistrictId])
}

model BusinessProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName            String?
  displayName          String
  contactEmail         String?
  contactPhone         String?
  verificationStatus   VerificationStatus @default(PENDING)
  billingInfo          Json?
  baseCityId           String?
  baseCity             City?              @relation("BusinessBaseCity", fields: [baseCityId], references: [id])
  primaryDistrictId    String?
  primaryDistrict      District?          @relation("BusinessPrimaryDistrict", fields: [primaryDistrictId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  places Place[]
  claims BusinessPlaceClaim[]

  @@index([baseCityId])
  @@index([primaryDistrictId])
}

model BusinessPlaceClaim {
  id                String      @id @default(uuid())
  businessId        String
  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  placeId           String
  place             Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  status            ClaimStatus @default(PENDING)
  evidenceUrl       String?
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([businessId, placeId])
}

model Review {
  id        String             @id @default(uuid())
  placeId   String
  place     Place              @relation(fields: [placeId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String?
  status    VerificationStatus @default(APPROVED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  @@unique([placeId, userId])
  @@index([placeId, status])
}

model Favorite {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FavoriteTargetType
  targetId   String
  createdAt  DateTime           @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model Report {
  id               String           @id @default(uuid())
  reporterUserId   String
  reporter         User             @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  targetType       ReportTargetType
  targetId         String
  reason           String
  details          String?
  status           ReportStatus     @default(OPEN)
  resolvedByAdminId String?
  resolutionNotes  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model TransportSystem {
  id                 String             @id @default(uuid())
  countryId          String
  country            Country            @relation(fields: [countryId], references: [id])
  cityId             String?
  city               City?              @relation(fields: [cityId], references: [id])
  name               String
  mode               TransportMode
  summary            String
  howItWorks         String?
  accessInstructions String?
  pricingType        PricingType        @default(UNKNOWN)
  priceMin           Decimal?           @db.Decimal(12, 2)
  priceMax           Decimal?           @db.Decimal(12, 2)
  currency           String             @default("TND") @db.Char(3)
  paymentMethods     PaymentMethod[]
  operatingHoursText String?
  coverageNotes      String?
  warnings           String[]
  appsJson           Json?
  verificationStatus VerificationStatus @default(DRAFT)
  sourceType         SourceType         @default(ADMIN)
  lastReviewedAt     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  hubs   TransportHub[]
  routes TransportRoute[]

  @@index([cityId, mode])
}

model TransportHub {
  id                String         @id @default(uuid())
  placeId           String
  place             Place          @relation(fields: [placeId], references: [id])
  transportSystemId String
  transportSystem   TransportSystem @relation(fields: [transportSystemId], references: [id], onDelete: Cascade)
  hubType           String
  name              String
  notes             String?
  createdAt         DateTime       @default(now())

  routesFrom TransportRoute[] @relation("RouteFrom")
  routesTo   TransportRoute[] @relation("RouteTo")
}

model TransportRoute {
  id                 String             @id @default(uuid())
  transportSystemId  String
  transportSystem    TransportSystem    @relation(fields: [transportSystemId], references: [id], onDelete: Cascade)
  fromHubId          String
  fromHub            TransportHub       @relation("RouteFrom", fields: [fromHubId], references: [id])
  toHubId            String
  toHub              TransportHub       @relation("RouteTo", fields: [toHubId], references: [id])
  approxDurationMin  Int?
  priceMin           Decimal?           @db.Decimal(12, 2)
  priceMax           Decimal?           @db.Decimal(12, 2)
  currency           String             @default("TND") @db.Char(3)
  frequencyNotes     String?
  verificationStatus VerificationStatus @default(DRAFT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model LocalRule {
  id                 String             @id @default(uuid())
  scope              RuleScope
  countryId          String?
  country            Country?           @relation(fields: [countryId], references: [id])
  cityId             String?
  city               City?              @relation(fields: [cityId], references: [id])
  category           RuleCategory
  severity           RuleSeverity       @default(INFO)
  audience           String             @default("ALL")
  title              String
  summary            String
  details            String?
  sourceType         SourceType         @default(ADMIN)
  sourceUrl          String?
  verificationStatus VerificationStatus @default(DRAFT)
  lastReviewedAt     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([cityId, category, severity])
}

model ArrivalGuide {
  id                 String             @id @default(uuid())
  cityId             String
  city               City               @relation(fields: [cityId], references: [id])
  airportPlaceId     String?
  title              String
  summary            String
  estimatedTotalTimeMin Int?
  audience           String             @default("ALL")
  verificationStatus VerificationStatus @default(DRAFT)
  lastReviewedAt     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  steps GuideStep[]
}

model HowToGuide {
  id                 String             @id @default(uuid())
  cityId             String?
  city               City?              @relation(fields: [cityId], references: [id])
  countryId          String?
  title              String
  summary            String
  categoryKey        String?
  verificationStatus VerificationStatus @default(DRAFT)
  lastReviewedAt     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  steps GuideStep[]
}

model GuideStep {
  id                       String          @id @default(uuid())
  parentType               GuideParentType
  arrivalGuideId           String?
  arrivalGuide             ArrivalGuide?   @relation(fields: [arrivalGuideId], references: [id], onDelete: Cascade)
  howToGuideId             String?
  howToGuide               HowToGuide?     @relation(fields: [howToGuideId], references: [id], onDelete: Cascade)
  stepOrder                Int
  title                    String
  actionType               GuideActionType
  description              String
  estimatedTimeMin         Int?
  estimatedCostMin         Decimal?        @db.Decimal(12, 2)
  estimatedCostMax         Decimal?        @db.Decimal(12, 2)
  currency                 String?         @db.Char(3)
  paymentMethods           PaymentMethod[]
  relatedTransportSystemId String?
  relatedPlaceId           String?
  warnings                 String[]
  isOptional               Boolean         @default(false)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

model Event {
  id                 String             @id @default(uuid())
  cityId             String
  city               City               @relation(fields: [cityId], references: [id])
  placeId            String?
  title              String
  summary            String
  description        String?
  startsAt           DateTime
  endsAt             DateTime?
  categoryId         String?
  category           Category?          @relation(fields: [categoryId], references: [id])
  priceLevel         PriceLevel?
  verificationStatus VerificationStatus @default(DRAFT)
  isSponsored        Boolean            @default(false)
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  @@index([cityId, startsAt])
}

model Experience {
  id                 String             @id @default(uuid())
  cityId             String
  city               City               @relation(fields: [cityId], references: [id])
  title              String
  summary            String
  description        String?
  durationMin        Int?
  priceLevel         PriceLevel?
  audience           String?
  verificationStatus VerificationStatus @default(DRAFT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  steps ExperienceStep[]
}

model ExperienceStep {
  id               String     @id @default(uuid())
  experienceId     String
  experience       Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  stepOrder        Int
  title            String
  description      String?
  placeId          String?
  estimatedTimeMin Int?
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityId    String?
  city      City?     @relation(fields: [cityId], references: [id])
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  messages Message[]
}

model Message {
  id          String      @id @default(uuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role        MessageRole
  content     String
  toolName    String?
  toolPayload Json?
  createdAt   DateTime    @default(now())

  citations MessageCitation[]

  @@index([conversationId, createdAt])
}

model MessageCitation {
  id         String  @id @default(uuid())
  messageId  String
  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  rank       Int     @default(0)
}

model RecommendationLog {
  id                String   @id @default(uuid())
  userId            String?
  contextJson       Json?
  resultEntityIds   String[]
  algorithmVersion  String?
  createdAt         DateTime @default(now())
}

model AiActionLog {
  id        String   @id @default(uuid())
  userId    String?
  actionType String
  status    String
  payload   Json?
  createdAt DateTime @default(now())
}

model AiModelConfig {
  id              String   @id @default(uuid())
  provider        String   @default("openrouter")
  modelId         String
  fallbackModelId String?
  enabled         Boolean  @default(true)
  updatedByAdminId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FeatureFlag {
  key            String   @id
  description    String?
  enabledGlobal  Boolean  @default(false)
  rulesJson      Json?
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  requestId   String?
  createdAt   DateTime @default(now())
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  eventName  String
  userId     String?
  sessionId  String?
  requestId  String?
  cityId     String?
  entityType String?
  entityId   String?
  appVersion String?
  platform   String?
  locale     String?
  properties Json?
  createdAt  DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
}

model Booking {
  id           String        @id @default(uuid())
  userId       String
  businessId   String?
  targetType   String
  targetId     String
  status       BookingStatus @default(DRAFT)
  scheduledAt  DateTime?
  partySize    Int?
  priceAmount  Decimal?      @db.Decimal(12, 2)
  currency     String        @default("TND") @db.Char(3)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Payment {
  id          String        @id @default(uuid())
  bookingId   String?
  userId      String
  provider    String
  providerRef String?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @db.Char(3)
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  planCode         String
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  providerRef      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}
