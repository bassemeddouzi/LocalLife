# Mobile env (Expo). Copy to apps/mobile/.env

# Phone testing: use your PC LAN IP (not localhost)
EXPO_PUBLIC_API_URL=http://192.168.1.12:3000

# Google Sign-In — WEB client ID is required (used as webClientId for ID tokens).
# Native sheet needs a development build (not Expo Go).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Mapbox public token (Guide Map + pick-on-map). Requires a native rebuild.
# Also accepted as MAPBOX_TOKEN (mirrored into Expo extra via app.config.js).
EXPO_PUBLIC_MAPBOX_TOKEN=
# Optional: only if Mapbox Maven download auth is required in your account
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
